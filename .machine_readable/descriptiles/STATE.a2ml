[implemented]
core = "Builtins-only Agda: candidates, inhabited cases, universal claims, identification, refinement and actual-world soundness"
contexts = "Assumption contexts and order-preserving thinnings"
composition = "Dependency-preserving claim composition with an inhabited joint case, plus observation coarsening"
revision = "Constructive evidence retraction and revision with explicit retained support"
finite-checker = "Certified checker for the explorer's signed-integer model, with explicit in-range and actual-world premises"
example = "Natural-number presence without identification for u+n=2 and n<=1"
explorer = "Imported finite signed-integer JavaScript model with proved checker correspondence over all 546 enumerated configurations"

